<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for AlterVPN.
  Permits cleartext traffic to VPNGate API and VPN relay servers that may
  not support HTTPS. All other traffic defaults to HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
