# Copy this file to keystore.properties and fill in your values.
# keystore.properties is in .gitignore — do NOT commit it.
#
# Keystore file lives next to this app's build.gradle:
#   android/app/upload-keystore.jks
#
# Create it (from android/app):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is relative to android/app/ (the app module).
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
