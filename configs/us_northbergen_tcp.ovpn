# AlterVPN OpenVPN profile — TCP fallback (rotated 2026-03-21)
#
# SECURITY NOTICE:
#   This file contains a private key (<key> block). Never commit or share this
#   file publicly. Rotate the profile by downloading a new autologin profile
#   from your OpenVPN Access Server and replacing this file.
#   Never include private key material in logs, chat, or documentation.
client
dev tun
dev-type tun

# Transport: TCP fallback on 443 (used when UDP/1194 is blocked)
proto tcp

# Server address — TCP port 443 bypasses most firewalls
remote 142.93.62.28 443

server-poll-timeout 4
nobind
resolv-retry infinite
persist-key
persist-tun

remote-cert-tls server
tls-version-min 1.2
reneg-sec 604800
tun-mtu 1420

# Keep if your flow needs OTP challenge
static-challenge "Enter Authenticator Code" 1

auth-user-pass
verb 3
push-peer-info

